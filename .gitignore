# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
defs/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/
*.egg-info/
.installed.cfg
*.egg

# Jupyter Notebook checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Virtual Environments
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# Environment configuration files (contains API keys)
.env
.env.local
.env.*.local

# IDE configurations
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Dataset storage (prevents committing heavy course data files)
**/data/raw/*
**/data/processed/*
*.csv
*.json
*.parquet
*.h5

# Deep Learning weights and checkpoints (prevents committing massive model binaries)
**/weights/*
*.pth
*.pt
*.pkl
*.onnx

# Vector Database local storage
**/chroma_db/